# Build artifacts — never commit compiled output, only source stays in the repo.
# NOTE: .gitignore does NOT support trailing/inline comments; keep comments on
# their own lines so the patterns below actually match.

# Object files (from `make` / `cc -c`)
*.o
*.obj

# Built binaries
transformer
*.exe
*.out
*.wasm
# cross-compile test outputs
xbuild_*

# Cross-compile output dir: ignore binaries, keep text/markdown docs
build/*
!build/*.md
!build/*.txt
# Two deliberate exceptions to "never commit compiled output":
#   - the Colab GPU binary, so it can be downloaded and uploaded to a notebook
#     without needing zig and this tree on hand
#   - the generated guide, which is a document rather than a build artifact
#     (regenerate with: cd tools/guidepdf && go run .)
!build/transformer-linux-x86_64-gpu
!build/guide.pdf

# Debug / linker artifacts
*.pdb
*.ilk

# Model checkpoints (generated weights, not source)
*.bin
*.gpt
*.vqt
# model/ subfolders: ignore weights, keep text/markdown (READMEs)
model/**/*.bin
model/**/*.gpt
model/**/*.vqt
# exported tokenizer vocab (generated by tools/export_tokenizer.py)
*.hf
model/**/*.hf

# Training data — keep the README + samples, ignore your own datasets
data/*
!data/README.md
!data/README.MD
!data/sample.txt
!data/identity.txt
!data/instruct.txt
!data/sft.txt
!data/sft_agent.txt
!data/so_commands.txt

# Agent demo artifact + the agent's default tool workspace (transformer agent)
agent_demo.txt
/workspace/

# Training / evaluation run logs (detached Start-Process stdout+stderr)
train_*.log
train_*.err
remeasure_*.log
remeasure_*.err
memtest_*.log
memtest_*.err
live_*.log
live_*.err
grpo_*.log
grpo_*.err

# Python bytecode cache (tools/ probes)
__pycache__/

# webchat Go server binary (POSIX build; the Windows .exe is caught by *.exe)
tools/webchat/webchat

# Image/video/audio media (data, not source) + the smoke-test temp dir
*.ppm
*.wav
vid_tmp/

# Generated sample outputs (imggen/audgen demos) — keep locally, don't commit
samples/

# NOTE: memory.md is intentionally TRACKED (committed) so it travels via git
# across machines — see it in the repo root.
!data/qa_sample.txt
